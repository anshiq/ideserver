                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        }
      },
      "put": {
        "operationId": "admin-patch-quota",
        "parameters": [
          {
            "in": "path",
            "name": "id",
